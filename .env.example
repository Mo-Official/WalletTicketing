# --- Allgemein ---------------------------------------------------------------
ORGANIZATION_NAME="Mein Veranstalter"
BASE_URL=http://localhost:8000          # öffentliche URL (für Zahlungs-Redirects & Wallet-Links)
DATABASE_URL=sqlite:///./walletticketing.db   # z.B. postgresql+psycopg://user:pw@host/db
SECRET_KEY=bitte-langen-zufaelligen-wert-setzen
TIMEZONE=Europe/Berlin
DEFAULT_CURRENCY=EUR

# --- Backend-Login & Scanner-API ----------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=bitte-aendern
SCANNER_API_KEY=                        # Bearer-Token für POST /api/check-in

# --- Zahlungsarten -------------------------------------------------------------
DEMO_PAYMENTS=true                      # In Produktion auf false setzen!
INVOICE_ENABLED=true
INVOICE_ACCOUNT_HOLDER="Mein Veranstalter GmbH"
INVOICE_IBAN="DE00 0000 0000 0000 0000 00"
INVOICE_BIC=
PENDING_ORDER_MINUTES=30

STRIPE_SECRET_KEY=                      # sk_live_... / sk_test_...
STRIPE_WEBHOOK_SECRET=                  # whsec_... (Webhook-URL: {BASE_URL}/webhooks/stripe)
STRIPE_PAYMENT_METHOD_TYPES=            # leer = automatisch (Karte, Apple Pay, Google Pay, Klarna, SEPA ...)

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_SANDBOX=true

# --- Apple Wallet --------------------------------------------------------------
APPLE_PASS_TYPE_ID=                     # pass.com.example.ticket
APPLE_TEAM_ID=
APPLE_CERT_PATH=certs/pass.pem
APPLE_KEY_PATH=certs/pass.key
APPLE_KEY_PASSWORD=
APPLE_WWDR_CERT_PATH=certs/wwdr.pem

# --- Google Wallet -------------------------------------------------------------
GOOGLE_ISSUER_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=certs/google-service-account.json
